# ---------- Product ----------
PRODUCT_NAME=CampusMind AI
PRODUCT_VERSION=2.0.0
PRODUCT_EDITION=Institutional
APP_ENV=production
SUPPORT_EMAIL=ai-support@example.edu
ADMIN_API_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=https://assistant.example.edu

# ---------- Tenant / Institute ----------
INSTITUTE_NAME=Example Engineering College
INSTITUTE_SHORT_NAME=EEC
MONITOR_BASE_URL=https://www.example.edu/
MONITOR_PAGES=,about/,admissions/,academics/,departments/,examinations/,news/,events/,contact/

# ---------- Runtime ----------
HOST=0.0.0.0
PORT=8000
AUTO_OPEN_BROWSER=false
REQUEST_TIMEOUT_SECONDS=20
DATABASE_URL=sqlite:///./college_chatbot.db
# PostGIS mode example:
# DATABASE_URL=postgresql://campusmind:change-me@localhost:5432/campusmind
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_SECONDS=60
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=900
RESPONSE_CACHE_MAX_ENTRIES=500
# Use only verified official contact details.
ESCALATION_EMAIL=
ESCALATION_PHONE=
ADMISSIONS_CONTACT_URL=https://admissions.egspgroup.in/
AUTH_REQUIRED=true
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=60
FIELD_ENCRYPTION_KEY=replace-with-a-valid-fernet-key
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# ---------- Real-time voice ----------
VOICE_STREAMING_ENABLED=true
VOICE_STT_MODEL=small
VOICE_STT_DEVICE=cpu
VOICE_STT_COMPUTE_TYPE=int8
VOICE_STT_CPU_THREADS=4
VOICE_PARTIAL_INTERVAL_SECONDS=1.5
VOICE_MIN_UTTERANCE_SECONDS=0.35
VOICE_MAX_AUDIO_BYTES=640000
VOICE_VAD_THRESHOLD=0.5
VOICE_MIN_RMS_ENERGY=0.012
VOICE_TTS_ENABLED=true
# edge = online streaming TTS; piper = local executable/model
VOICE_TTS_ENGINE=edge
PIPER_EXECUTABLE=piper
PIPER_MODEL_PATH=
PIPER_SAMPLE_RATE=22050

# ---------- AI / RAG ----------
SLM_MODEL_PATH=models/phi3-mini
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
VECTOR_DB_PATH=vector_db
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=3
SIMILARITY_THRESHOLD=0.55
STRICT_MODE=true
ENABLE_HYBRID_SEARCH=true
VECTOR_WEIGHT=0.70
KEYWORD_WEIGHT=0.30
HYBRID_CANDIDATE_K=12
HYBRID_THRESHOLD=0.45
ENABLE_RERANKER=true
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_CANDIDATE_K=12
RERANKER_WEIGHT=0.70
ENABLE_LANGGRAPH=true
# Local default: chroma. Production: pgvector + PGVECTOR_URL.
VECTOR_BACKEND=chroma
PGVECTOR_URL=
# When PostgreSQL mode is enabled, verified entries from data/campus_locations.json
# are upserted into PostGIS during the first location-aware query.
PGVECTOR_COLLECTION=campusmind_knowledge

# ---------- Auto Sync ----------
MONITOR_ENABLED=true
MONITOR_INTERVAL_SECONDS=3600
MONITOR_MAX_PAGES=5000
MONITOR_RETRIES=3
MONITOR_MIN_TEXT_LENGTH=40

# Production traffic protection (tune after load testing)
# CPU-only local SLM: start low (1-2 concurrent generations) to avoid RAM/CPU collapse.
LLM_MAX_CONCURRENT=2
LLM_MAX_QUEUE=64
LLM_QUEUE_TIMEOUT_SECONDS=12
REQUEST_TIMEOUT_SECONDS=20
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_SECONDS=60
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=900
RESPONSE_CACHE_MAX_ENTRIES=1000

# LettuceDetect hallucination verification
LETTUCEDETECT_ENABLED=true
LETTUCEDETECT_MODEL=KRLabsOrg/lettucedect-base-modernbert-en-v1
LETTUCEDETECT_MIN_CONFIDENCE=0.80

# Multi-source official institute knowledge sync
OFFICIAL_SOURCE_ROOTS=https://egspec.org/,https://coe.egspec.org/,https://admissions.egspgroup.in/

# -----------------------------------------------------------------------------
# Secure network-resilient official-source synchronization
# -----------------------------------------------------------------------------
# auto: normal direct connection; configured proxy/CA are used when provided.
# offline: never accesses websites; chatbot keeps answering from local index.
NETWORK_MODE=auto
NETWORK_CONNECT_TIMEOUT=10
NETWORK_READ_TIMEOUT=30
NETWORK_MAX_RETRIES=4
NETWORK_BACKOFF_FACTOR=0.8
NETWORK_CIRCUIT_FAILURES=5
NETWORK_CIRCUIT_RESET_SECONDS=60
NETWORK_POOL_CONNECTIONS=10
NETWORK_POOL_MAXSIZE=20
NETWORK_JITTER_MS=120

# Optional authorized college/company proxy. Leave blank on normal Wi-Fi/hotspot.
NETWORK_HTTP_PROXY=
NETWORK_HTTPS_PROXY=

# Optional trusted institutional CA PEM path (for authorized TLS inspection).
NETWORK_CA_BUNDLE=

# Optional credentials ONLY for institute endpoints you are authorized to access.
NETWORK_BASIC_AUTH_USER=
NETWORK_BASIC_AUTH_PASSWORD=

# Synchronization is restricted to these trusted domains/subdomains.
NETWORK_ALLOWED_DOMAINS=egspec.org,coe.egspec.org,egspgroup.in,admissions.egspgroup.in

# ===== Advanced safe web ingestion =====
# Existing Requests/BeautifulSoup crawler always runs first.
# Thin/JS-heavy pages can fall back to Crawl4AI -> local Anakin -> Playwright.
ADVANCED_WEB_INGESTION=true
ADVANCED_WEB_MIN_TEXT=180
CRAWL4AI_ENABLED=true
PLAYWRIGHT_FALLBACK_ENABLED=true
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_SETTLE_MS=1200

# AnakinScraper OSS is optional. Safe default: disabled and localhost-only.
ANAKIN_ENABLED=false
ANAKIN_BASE_URL=http://127.0.0.1:8080
ANAKIN_ALLOW_REMOTE=false
